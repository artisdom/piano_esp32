# Piano Coach on the ESP32-Audio-Kit (ESP32-A1S: ESP32 rev 3, 4 MB flash,
# 8 MB PSRAM). Console on UART0 (CP2102).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_REV_MIN_3=y

# 1 kHz tick: MIDI timing needs ms resolution.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# PSRAM (rev 3 needs no cache workaround): every plain malloc goes there
# first (ALWAYSINTERNAL=0) — songs, the search index's thousands of small
# strings, lwIP buffers; internal RAM stays for Wi-Fi/BT/coexistence, DMA
# and the stacks of threads that write flash (they ask for it explicitly).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# microSD: long file names in UTF-8 (the song library is Chinese).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y

# Wi-Fi access point for the web page, alongside BLE (coexistence).
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# BLE only, NimBLE central, one link.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=260
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Host flow control OFF. ESP-IDF turns it on for the original ESP32 only,
# and with it this controller stops handing the piano's packets to NimBLE
# once it has sent as many as NimBLE has ACL buffers (24 by default): the
# host's buffer credits evidently never come back. The piano's key presses
# then stop arriving, the link drops (0x208), and later connections get no
# ATT answers until a reset. ESP32-2432S028: with flow control the link
# died ~1 s into playing (17 notifications); without it, 14 minutes of
# Follow and ~1900 notifications without a drop.
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n

# Internal RAM is the limit with Wi-Fi + BLE: small Wi-Fi buffer pools (a
# phone page needs little throughput), and threads that never touch flash
# keep their stacks in PSRAM (src/threads.rs).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
