# Ai-Thinker ESP32-Audio-Kit V2.2/V2.3 — ESP32-A1S (ESP32 rev 3, 4 MB flash,
# 8 MB PSRAM, ES8388 codec), speaker/headphone out, microSD, six keys, no
# display: keys + tones + a Wi-Fi web page (headless UI), songs from the
# card, the piano over BLE. Console on the CP2102 (/dev/ttyUSB*).
FEATURE=board-audiokit
MCU=esp32
ESP_IDF_VERSION=v5.5.3
# Xtensa: the esp-rs toolchain (espup install --name esp198 --toolchain-version 1.98.1.0).
TARGET=xtensa-esp32-espidf
TOOLCHAIN=esp198
FLASHER=espflash
UI=headless
HAS="sd speaker"
# 4 MB flash with Wi-Fi + BLE + HTTP: build for size.
CARGO_CONFIG="'profile.release.package.piano-coach.opt-level=\"s\"'"
