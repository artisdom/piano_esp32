# ESP32-2432S028R ("Cheap Yellow Display") — ESP32-WROOM-32 (4 MB flash, no
# PSRAM), 2.8" 320x240 ILI9341 on SPI, XPT2046 resistive touch, BOOT key,
# RGB LED, microSD, speaker amplifier on the DAC; CH340 console
# (/dev/ttyUSB*). Minimal UI, songs from the flash song pack, BLE to the
# piano.
FEATURE=board-2432s028
MCU=esp32
ESP_IDF_VERSION=v5.5.3
# Xtensa: the esp-rs toolchain (espup install --name esp198 --toolchain-version 1.98.1.0).
TARGET=xtensa-esp32-espidf
TOOLCHAIN=esp198
FLASHER=espflash
UI=mini
HAS=
# 1.4 MB of songs in 4 MB flash, small categories first; internal RAM only
# (as on the ESP-WROVER-KIT and the ESP32-C3), so the same note limit.
SONGPACK_ARGS="--max-bytes 1400K --max-notes 1200 --prefer 儿时回忆（41） --prefer 红色歌谣（52） --prefer 影视剧场（240）"
# 4 MB flash: build the renderer for size.
CARGO_CONFIG="'profile.release.package.i-slint-core.opt-level=\"s\"' 'profile.release.package.i-slint-renderer-software.opt-level=\"s\"' 'profile.release.package.piano-coach.opt-level=\"s\"'"
