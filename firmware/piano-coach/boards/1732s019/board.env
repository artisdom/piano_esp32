# ESP32-1732S019 — ESP32-S3-WROOM-1 (16 MB flash, 8 MB octal PSRAM),
# 1.9" 170x320 ST7789 IPS (SPI), no touch, BOOT key, no microSD / USB host /
# speaker: songs live in flash (tools/songs.sh), the piano is reached over BLE.
FEATURE=board-1732s019
MCU=esp32s3
ESP_IDF_VERSION=v5.5.3
# Xtensa: the esp-rs toolchain (espup install --name esp198 --toolchain-version 1.98.1.0).
TARGET=xtensa-esp32s3-espidf
TOOLCHAIN=esp198
FLASHER=espflash
# Minimal UI for small screens; no USB host, microSD or speaker.
UI=mini
HAS=
# Song pack (tools/songs.sh): the whole library fits in the 11.9 MB partition.
SONGPACK_ARGS="--max-bytes 11.9M"
