# VCC-GND Studio YD-ESP32-S3 (ESP32-S3-WROOM-1 N16R8: 16 MB flash, 8 MB
# octal PSRAM), BOOT and RST keys, WS2812 RGB LED, two USB-C ports: CH343
# console (/dev/ttyACM*) and the S3's native USB as OTG host for the piano
# ("USB-OTG" jumper bridged so the port supplies VBUS). No display:
# BOOT key + RGB LED + a Wi-Fi web page (headless UI); songs from the flash
# song pack; the piano over USB and BLE at once (USB preferred).
FEATURE=board-yds3
MCU=esp32s3
ESP_IDF_VERSION=v5.5.3
# Xtensa: the esp-rs toolchain (espup install --name esp198 --toolchain-version 1.98.1.0).
TARGET=xtensa-esp32s3-espidf
TOOLCHAIN=esp198
FLASHER=espflash
UI=headless
HAS="usb"
# Song pack (tools/songs.sh): the whole library fits in the 11.9 MB partition.
SONGPACK_ARGS="--max-bytes 11.9M"
