# LILYGO T-Display-S3 — ESP32-S3R8 (16 MB flash, 8 MB octal PSRAM), 1.9"
# 170x320 ST7789 on an 8-bit i80 bus, two keys (BOOT, KEY), optional CST816
# touch, Li-ion charger; console on the S3's USB Serial/JTAG. No microSD /
# USB host / speaker: songs live in flash (tools/songs.sh), BLE to the piano.
FEATURE=board-tdisplays3
MCU=esp32s3
ESP_IDF_VERSION=v5.5.3
# Xtensa: the esp-rs toolchain (espup install --name esp198 --toolchain-version 1.98.1.0).
TARGET=xtensa-esp32s3-espidf
TOOLCHAIN=esp198
FLASHER=espflash
UI=mini
HAS=
# Song pack (tools/songs.sh): the whole library fits in the 11.9 MB partition.
SONGPACK_ARGS="--max-bytes 11.9M"
