# Piano Coach on ESP32-S31-Korvo-1 V1.1 (ESP32-S31-WROOM-3: 16 MB flash,
# 16 MB PSRAM). Needs ESP-IDF master (>= 6.1). Settings proven by the
# herdline Korvo port (~/w/rust/herdline/clients/tab5/boards/esp32-s31-korvo-1).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz tick: MIDI timing needs ms resolution.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# PSRAM for framebuffers, the render shadow buffer, songs and — on this
# board — application thread stacks (internal RAM is kept for the radio,
# USB and DMA; see src/board/korvo/mod.rs).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# microSD: long file names in UTF-8 (the song library is Chinese).
# exFAT/GPT are enabled by tools/patch-idf-exfat.sh (no Kconfig exists).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_USE_LABEL=y
CONFIG_VFS_MAX_COUNT=12

# Camera is not used (the BSP still links its driver).
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n

# Native BLE controller + NimBLE host, central only.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=260
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# NimBLE logs every GATT write at INFO — two console lines per MIDI packet.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# USB-A: native USB 2.0 HS host behind a 500 mA power switch.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
