# ESP32-S31-Korvo-1 V1.1 — ESP32-S31-WROOM-3, 800x480 RGB sub-board (SUB3)
# with GT1151 touch, native BLE.
FEATURE=board-korvo
MCU=esp32s31
# No ESP-IDF release supports the S31 yet: an ESP-IDF master (>= 6.1)
# checkout. IDF_PATH overrides this default.
IDF_PATH_DEFAULT=/home/nws/w/esp32/esp-idf
# The master toolchain defaults to picolibc; Rust's std must agree.
PICOLIBC=1
# Enable exFAT/GPT in that checkout's FatFs (idempotent).
PATCH_EXFAT=1
# espflash cannot package S31 PSRAM-XIP images: use ESP-IDF's esptool.
FLASHER=idf
# Full UI (1280-wide design) with USB host, microSD and speaker.
UI=full
HAS="usb sd speaker"
