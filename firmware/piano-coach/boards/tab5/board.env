# M5Stack Tab5 — ESP32-P4 rev 1.3, 1280x720 MIPI-DSI (ST7123 / ILI9881C),
# ESP32-C6 radio over SDIO (ESP-Hosted).
FEATURE=board-tab5
MCU=esp32p4
# Released ESP-IDF, cloned by embuild into ESP_IDF_TOOLS_INSTALL_DIR.
ESP_IDF_VERSION=v5.5.3
# espflash with this build's bootloader/partition table.
FLASHER=espflash
# Full UI (1280-wide design) with USB host, microSD and speaker.
UI=full
HAS="usb sd speaker"
