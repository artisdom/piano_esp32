# ESP32-2424S012C — ESP32-C3-MINI-1U (4 MB flash, no PSRAM, 400 KB SRAM),
# 1.28" round 240x240 GC9A01 IPS (SPI), CST816D touch, BOOT key, Li-ion
# charger; no microSD / USB host / speaker: songs live in flash
# (tools/songs.sh), the piano is reached over BLE.
FEATURE=board-2424s012
MCU=esp32c3
ESP_IDF_VERSION=v5.5.3
# RISC-V without atomics/FPU: nightly + build-std (rust-toolchain.toml).
TARGET=riscv32imc-esp-espidf
FLASHER=espflash
UI=mini
HAS=
# 1.4 MB of songs: the small categories first, and only songs whose note
# data fits the C3's RAM next to Bluetooth and the UI.
SONGPACK_ARGS="--max-bytes 1400K --max-notes 1200 --prefer 儿时回忆（41） --prefer 红色歌谣（52） --prefer 影视剧场（240）"
# 4 MB flash: build the renderer for size (the default profile builds Slint
# and the app at opt-level 3 for the big panels' frame rate).
CARGO_CONFIG="'profile.release.package.i-slint-core.opt-level=\"s\"' 'profile.release.package.i-slint-renderer-software.opt-level=\"s\"' 'profile.release.package.piano-coach.opt-level=\"s\"'"
