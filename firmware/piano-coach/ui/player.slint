import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Segmented, Card, Chip } from "widgets.slint";
import { PlayerVM, KeyView, RollNote } from "state.slint";

// Fixed geometry shared with src/ui.rs (keys and roll are laid out in Rust).
export global Geometry {
    out property <length> keys-width: 1248px;
    out property <length> keys-height: 150px;
    out property <length> roll-height: 300px;
}

component Keyboard inherits Rectangle {
    width: Geometry.keys-width;
    height: Geometry.keys-height;
    // LED strip above the keys, mirroring the piano's red key LEDs.
    for k in PlayerVM.keys: Rectangle {
        x: k.x + (k.w - 8px) / 2;
        y: 2px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: mod(k.state, 2) == 1 ? Theme.led : #2a2f37;
    }
    for k in PlayerVM.keys: Rectangle {
        x: k.x;
        y: 14px;
        width: k.black ? k.w : k.w - 2px;
        height: k.black ? (parent.height - 14px) * 0.62 : parent.height - 14px;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
        // pressed (blue) > wrong (amber) > lit hint/LED (red) > idle
        background: mod(floor(k.state / 2), 2) == 1 ? Theme.pressed
            : mod(floor(k.state / 4), 2) == 1 ? Theme.warn
            : mod(k.state, 2) == 1 ? (k.black ? Theme.led.darker(0.1) : #ffb3bb)
            : (k.black ? #1b1f25 : #eef1f5);
        border-width: k.black ? 1px : 0px;
        border-color: #000000;
        if !k.black && k.label != "": Text {
            y: parent.height - 24px;
            width: parent.width;
            horizontal-alignment: center;
            text: k.label;
            font-size: 11px;
            color: #7d8794;
        }
    }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text;
    min-width: 92px;
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text { text: root.value; font-size: Theme.fs-lg; font-weight: 700; color: root.tone; horizontal-alignment: center; }
        Text { text: root.label; font-size: Theme.fs-xs; color: Theme.dim; horizontal-alignment: center; }
    }
}

// Score / loop chip (top-right) and the Learn prompt (top-centre), over
// the roll or the sheet.
component Overlay inherits Rectangle {
    // Score + loop counter, top-right.
    if PlayerVM.loaded && (PlayerVM.mode != 0 || PlayerVM.loop-text != ""): Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: stats.preferred-width + 24px;
        height: 64px;
        border-radius: 14px;
        background: #000000a0;
        stats := HorizontalLayout {
            x: 12px;
            spacing: 4px;
            if PlayerVM.mode != 0: Stat { label: "accuracy"; value: PlayerVM.accuracy; tone: Theme.ok; }
            if PlayerVM.mode != 0: Stat { label: PlayerVM.mode == 1 ? "chords" : "notes"; value: PlayerVM.steps; }
            if PlayerVM.mode != 0: Stat { label: "streak"; value: PlayerVM.streak; tone: Theme.warn; }
            if PlayerVM.loop-text != "": Stat { label: "loop"; value: PlayerVM.loop-text; tone: Theme.right-hand; }
        }
    }
    // Learn prompt.
    if PlayerVM.prompt != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        width: pt.preferred-width + 40px;
        height: 48px;
        border-radius: 24px;
        background: #000000a0;
        pt := Text {
            text: PlayerVM.prompt;
            font-size: Theme.fs-lg;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component Roll inherits Rectangle {
    width: Geometry.keys-width;
    height: Geometry.roll-height;
    border-radius: Theme.radius;
    background: @linear-gradient(180deg, #11151b 0%, #161b23 100%);
    clip: true;
    // Octave guide lines at each C.
    for k in PlayerVM.keys: Rectangle {
        visible: k.label != "";
        x: k.x;
        width: 1px;
        background: #ffffff10;
    }
    for n in PlayerVM.roll: Rectangle {
        x: n.x;
        y: n.y;
        width: n.w;
        height: n.h;
        border-radius: 4px;
        background: n.kind == 0 ? Theme.right-hand
            : n.kind == 1 ? Theme.left-hand
            : n.kind == 2 ? Theme.led
            : #3a4350;
        opacity: n.kind == 3 ? 0.6 : 1.0;
    }
    // The "now" line where notes meet the keys.
    Rectangle {
        y: PlayerVM.now-line;
        height: 3px;
        background: Theme.led.with-alpha(0.7);
    }
    Overlay { }
    if !PlayerVM.loaded: Text {
        text: "Pick a song in the Library, then press Learn, Follow or Listen.";
        color: Theme.dim;
        font-size: Theme.fs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Sheet music: two systems of a grand staff on paper, the play cursor and
// the notes to play now in LED red. Laid out in Rust (piano_core::notation).
component Sheet inherits Rectangle {
    property <color> ink: #1d2128;
    property <length> sp: PlayerVM.sheet-space;
    background: #f6f3ec;
    clip: true;
    for r in PlayerVM.sheet-rects: Rectangle {
        x: r.x;
        y: r.y;
        width: r.w;
        height: r.h;
        background: ink;
    }
    // Cursor behind the notes.
    if PlayerVM.cursor-visible: Rectangle {
        x: PlayerVM.cursor-x - 2px;
        y: PlayerVM.cursor-y;
        width: 4px;
        height: PlayerVM.cursor-h;
        border-radius: 2px;
        background: #4da3ff90;
    }
    // Clefs, accidentals, heads and rests: Noto Music glyphs exported as
    // SVGs (tools/make_music_glyphs.py), in piano_core::notation::Glyph order.
    for g in PlayerVM.sheet-glyphs: Rectangle {
        x: g.x;
        y: g.y;
        width: g.w;
        height: g.h;
        property <bool> now: g.ms >= 0 && abs(g.ms - PlayerVM.sheet-now) <= 40
            && (g.staff == 0 ? mod(PlayerVM.sheet-staves, 2) == 1 : PlayerVM.sheet-staves >= 2);
        // With pitch colours the notes to play now get a red halo.
        if now && g.colored: Rectangle {
            x: -0.45 * sp;
            y: -0.4 * sp;
            width: parent.width + 0.9 * sp;
            height: parent.height + 0.8 * sp;
            border-radius: self.height / 2;
            background: Theme.led.with-alpha(0.25);
            border-width: 2.5px;
            border-color: Theme.led;
        }
        Image {
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            source: g.kind == 0 ? @image-url("sheet/gclef.svg") : g.kind == 1 ? @image-url("sheet/fclef.svg") : g.kind == 2 ? @image-url("sheet/sharp.svg") : g.kind == 3 ? @image-url("sheet/flat.svg") : g.kind == 4 ? @image-url("sheet/natural.svg") : g.kind == 5 ? @image-url("sheet/head-black.svg") : g.kind == 6 ? @image-url("sheet/head-half.svg") : g.kind == 7 ? @image-url("sheet/head-whole.svg") : g.kind == 8 ? @image-url("sheet/rest-whole.svg") : g.kind == 9 ? @image-url("sheet/rest-half.svg") : g.kind == 10 ? @image-url("sheet/rest-quarter.svg") : g.kind == 11 ? @image-url("sheet/rest-8.svg") : @image-url("sheet/rest-16.svg");
            colorize: g.colored ? g.color : now ? Theme.led : ink;
        }
        // Dark rim over a coloured filled head (light colours on paper).
        if g.outline: Image {
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            source: @image-url("sheet/head-half.svg");
            colorize: ink;
        }
        if g.label != "": Text {
            width: parent.width;
            height: parent.height;
            text: g.label;
            // One letter fills the head; two (do, re, …) a little smaller.
            font-size: (PlayerVM.sheet-names == 2 ? 0.68 : 0.86) * sp;
            font-weight: 700;
            color: g.label-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    for d in PlayerVM.sheet-dots: Rectangle {
        x: d.x - 0.22 * sp;
        y: d.y - 0.22 * sp;
        width: 0.44 * sp;
        height: 0.44 * sp;
        border-radius: 0.22 * sp;
        background: ink;
    }
    // Flags and ties are SVG shapes (rasterised at build time), tinted.
    for f in PlayerVM.sheet-flags: Image {
        x: f.x;
        y: f.up ? f.y : f.y - 3 * sp;
        width: 1.1 * sp;
        height: 3 * sp;
        source: f.up ? @image-url("sheet/flag-up.svg") : @image-url("sheet/flag-down.svg");
        image-fit: fill;
        colorize: ink;
    }
    for t in PlayerVM.sheet-ties: Image {
        x: t.x;
        y: t.up ? t.y - 0.6 * sp : t.y;
        width: t.w;
        height: 0.6 * sp;
        source: t.up ? @image-url("sheet/tie-up.svg") : @image-url("sheet/tie-down.svg");
        image-fit: fill;
        colorize: ink;
    }
    for d in PlayerVM.sheet-digits: Text {
        x: d.x - 1.5 * sp;
        y: d.y - 1.3 * sp;
        width: 3 * sp;
        height: 2.6 * sp;
        text: d.text;
        font-size: 2.6 * sp;
        font-weight: 900;
        color: ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if PlayerVM.sheet-message != "": Text {
        text: PlayerVM.sheet-message;
        color: #6b7280;
        font-size: Theme.fs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BandButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: root.text == "" ? 48px : max(48px, label.preferred-width + 24px);
    height: 44px;
    border-radius: 22px;
    background: ta.pressed ? Theme.raised.brighter(0.2) : on ? Theme.accent : Theme.raised;
    if root.icon != "": Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 22px;
    }
    label := Text {
        visible: root.text != "";
        text: root.text;
        font-size: Theme.fs-sm;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Full-screen sheet music: a slim band with the song, the Learn prompt,
// the score and the controls; the rest of the screen is paper.
component FullSheet inherits Rectangle {
    background: #f6f3ec;
    property <length> band: 52px;
    Rectangle {
        height: band;
        y: 0;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 160px;
                Text { text: PlayerVM.title; font-size: Theme.fs; font-weight: 700; color: Theme.text; overflow: elide; }
            }
            // Learn prompt / state, then the score.
            VerticalLayout {
                alignment: center;
                Text {
                    text: PlayerVM.prompt;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                    color: Theme.led;
                    overflow: elide;
                    max-width: 380px;
                }
            }
            if PlayerVM.mode != 0: VerticalLayout {
                alignment: center;
                Text {
                    text: PlayerVM.accuracy + "  ·  " + PlayerVM.steps + "  ·  " + PlayerVM.streak + "×";
                    font-size: Theme.fs-sm;
                    color: Theme.dim;
                }
            }
            if PlayerVM.loop-text != "": VerticalLayout {
                alignment: center;
                Text { text: "loop " + PlayerVM.loop-text; font-size: Theme.fs-sm; color: Theme.right-hand; }
            }
            BandButton { y: (band - self.height) / 2; icon: "replay"; clicked => { PlayerVM.restart(); } }
            BandButton {
                y: (band - self.height) / 2;
                icon: PlayerVM.state == 1 || PlayerVM.state == 2 ? "pause" : "play";
                on: true;
                clicked => { PlayerVM.play-pause(); }
            }
            BandButton { y: (band - self.height) / 2; icon: "minus"; clicked => { PlayerVM.tempo-step(-10); } }
            VerticalLayout {
                alignment: center;
                min-width: 52px;
                Text { text: PlayerVM.tempo + "%"; font-size: Theme.fs-sm; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
            }
            BandButton { y: (band - self.height) / 2; icon: "plus"; clicked => { PlayerVM.tempo-step(10); } }
            BandButton {
                y: (band - self.height) / 2;
                text: PlayerVM.sheet-colors == 0 ? "Ink" : PlayerVM.sheet-colors == 1 ? "Boomwhackers" : "Rainbow";
                clicked => { PlayerVM.set-sheet-colors(mod(PlayerVM.sheet-colors + 1, 3)); }
            }
            BandButton {
                y: (band - self.height) / 2;
                text: PlayerVM.sheet-names == 0 ? "No names" : PlayerVM.sheet-names == 1 ? "C D E" : "Do Re Mi";
                clicked => { PlayerVM.set-sheet-names(mod(PlayerVM.sheet-names + 1, 3)); }
            }
            // Leave full screen: back to the keyboard view.
            BandButton { y: (band - self.height) / 2; icon: "close"; clicked => { PlayerVM.set-sheet(false); } }
        }
    }
    Sheet {
        y: band;
        height: parent.height - band;
    }
}

export component PlayerPage inherits Rectangle {
    if PlayerVM.sheet: FullSheet { }
    if !PlayerVM.sheet: Rectangle {
    VerticalLayout {
        padding: 16px;
        padding-top: 10px;
        spacing: 10px;
        // Title + mode + hands
        HorizontalLayout {
            height: 60px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: PlayerVM.title;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: PlayerVM.subtitle;
                    font-size: Theme.fs-sm;
                    color: Theme.dim;
                    overflow: elide;
                }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                options: ["Learn", "Follow", "Listen"];
                icons: ["learn", "follow", "listen"];
                // UI order differs from the engine's mode numbering.
                selected: PlayerVM.mode == 1 ? 0 : PlayerVM.mode == 2 ? 1 : 2;
                changed(i) => { PlayerVM.set-mode(i == 0 ? 1 : i == 1 ? 2 : 0); }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                options: ["Both", "Right", "Left"];
                selected: PlayerVM.hands;
                changed(i) => { PlayerVM.set-hands(i); }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                options: ["Keys", "Sheet"];
                icons: ["library", "note"];
                selected: PlayerVM.sheet ? 1 : 0;
                changed(i) => { PlayerVM.set-sheet(i == 1); }
            }
        }
        // Transport, progress, tempo, stats
        HorizontalLayout {
            height: 64px;
            spacing: 12px;
            Button {
                icon: "replay";
                width: 60px;
                enabled: PlayerVM.loaded;
                clicked => { PlayerVM.restart(); }
            }
            Button {
                icon: PlayerVM.state == 1 || PlayerVM.state == 2 ? "pause" : "play";
                primary: true;
                width: 64px;
                enabled: PlayerVM.loaded;
                clicked => { PlayerVM.play-pause(); }
            }
            Button {
                icon: "stop";
                width: 60px;
                enabled: PlayerVM.loaded;
                clicked => { PlayerVM.stop(); }
            }
            Text { text: PlayerVM.pos-text; font-size: Theme.fs-sm; color: Theme.dim; vertical-alignment: center; min-width: 48px; horizontal-alignment: right; }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.raised;
                }
                Rectangle {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    height: 8px;
                    width: parent.width * PlayerVM.progress;
                    border-radius: 4px;
                    background: Theme.accent;
                }
                // Loop section and its A / B markers.
                if PlayerVM.loop-a >= 0 && PlayerVM.loop-b > PlayerVM.loop-a: Rectangle {
                    x: parent.width * PlayerVM.loop-a;
                    width: parent.width * (PlayerVM.loop-b - PlayerVM.loop-a);
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    border-radius: 6px;
                    background: Theme.right-hand.with-alpha(0.28);
                    border-width: 1px;
                    border-color: Theme.right-hand;
                }
                if PlayerVM.loop-a >= 0: Rectangle {
                    x: parent.width * PlayerVM.loop-a - 1px;
                    width: 3px;
                    y: (parent.height - self.height) / 2;
                    height: 30px;
                    background: Theme.right-hand;
                }
                if PlayerVM.loop-b >= 0: Rectangle {
                    x: parent.width * PlayerVM.loop-b - 1px;
                    width: 3px;
                    y: (parent.height - self.height) / 2;
                    height: 30px;
                    background: Theme.right-hand;
                }
                TouchArea {
                    enabled: PlayerVM.loaded;
                    clicked => { PlayerVM.seek(max(0, min(1, self.mouse-x / self.width))); }
                }
            }
            Text { text: PlayerVM.dur-text; font-size: Theme.fs-sm; color: Theme.dim; vertical-alignment: center; min-width: 48px; }
            Rectangle { width: 4px; }
            // Practice a section: A = loop start (snaps to the chord at or
            // before now), B = loop end; the third button clears the loop.
            Button {
                text: "A";
                width: 56px;
                primary: PlayerVM.loop-a >= 0;
                enabled: PlayerVM.loaded;
                clicked => { PlayerVM.set-loop-a(); }
            }
            Button {
                text: "B";
                width: 56px;
                primary: PlayerVM.loop-b >= 0;
                enabled: PlayerVM.loaded;
                clicked => { PlayerVM.set-loop-b(); }
            }
            Button {
                icon: PlayerVM.looping || PlayerVM.loop-a >= 0 ? "close" : "loop";
                width: 56px;
                enabled: PlayerVM.loop-a >= 0 || PlayerVM.loop-b >= 0;
                clicked => { PlayerVM.clear-loop(); }
            }
            Rectangle { width: 4px; }
            Button { icon: "minus"; width: 52px; clicked => { PlayerVM.tempo-step(-10); } }
            VerticalLayout {
                alignment: center;
                min-width: 72px;
                Text { text: PlayerVM.tempo + "%"; font-size: Theme.fs-lg; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                Text { text: "tempo"; font-size: Theme.fs-xs; color: Theme.dim; horizontal-alignment: center; }
            }
            Button { icon: "plus"; width: 52px; clicked => { PlayerVM.tempo-step(10); } }
        }
        Roll { }
        Keyboard { }
    }
    }
}
