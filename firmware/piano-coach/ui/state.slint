// View-models shared between Rust (src/ui.rs) and the pages.

export struct LibEntry {
    title: string,
    subtitle: string,
    is-dir: bool,
    // Songs: bookmarked, and best-score stars ("★★☆", "" if never scored).
    fav: bool,
    badge: string,
}

export struct LegendItem {
    name: string,
    tint: color,
}

// One key of the on-screen keyboard. Geometry is computed in Rust so white
// and black keys line up exactly; `state` bits: 1 = LED lit by us (hint or
// sounding note), 2 = pressed on the piano, 4 = wrong-key flash,
// 8 = hint (the learner's next note).
export struct KeyView {
    x: length,
    w: length,
    black: bool,
    state: int,
    label: string,
}

// A falling note in the piano roll. kind: 0 right hand, 1 left hand,
// 2 learner's current target, 3 already played / passed.
export struct RollNote {
    x: length,
    y: length,
    w: length,
    h: length,
    kind: int,
}

export global AppVM {
    in-out property <int> page: 0; // 0 library, 1 play, 2 settings
    in property <bool> connected;
    in property <string> device: "Piano not connected";
    in property <string> sd-status: "";
    in property <string> toast: "";
    in property <string> version: "";
    in property <string> transport: "USB";
    // Board capabilities (src/board, `CAPS`).
    in property <string> board-name: "";
    in property <bool> has-backlight: true;
    in property <bool> has-power-latch: true;
    // "Show touches" diagnostic: where the firmware thinks the finger is.
    in-out property <bool> show-touches;
    callback set-show-touches(bool);
    in property <bool> touching;
    in property <length> touch-x;
    in property <length> touch-y;
    // Shut-down confirmation dialog and the "shutting down" screen.
    in-out property <bool> confirm-shutdown;
    in property <bool> shutting-down;
    callback shutdown();
}

export global LibraryVM {
    in property <[string]> crumbs;
    in property <string> path-text;
    in property <[LibEntry]> entries;
    in property <string> empty-text: "";
    in-out property <int> selected: -1;
    // Selected song card.
    in property <string> sel-title;
    in property <string> sel-subtitle;
    in property <string> sel-info;
    in property <bool> sel-ready;
    in property <string> sel-error;
    in property <bool> sel-fav;
    in property <string> sel-scores;
    callback toggle-fav();
    // Library view: 0 folders, 1 bookmarks, 2 recently played, 3 song globe.
    in-out property <int> view: 0;
    callback set-view(int);
    // Song globe: painted by Rust into the framebuffer at this origin.
    callback sphere-origin(length, length);
    in property <[LegendItem]> legend;
    callback sphere-pointer(int, length, length); // 0 down, 1 move, 2 up
    callback legend-tap(int);
    callback open(int);
    callback up();
    callback crumb(int);
    callback start(int); // 0 listen, 1 learn, 2 follow
    // Library-wide search (pinyin / initials / Latin letters).
    in-out property <bool> searching;
    in property <string> query;
    in property <string> search-status;
    in property <[LibEntry]> results;
    in-out property <int> result-selected: -1;
    callback search-toggle();
    callback type-key(string);
    callback backspace();
    callback clear-query();
    callback open-result(int);
}

export global PlayerVM {
    in property <string> title: "No song loaded";
    in property <string> subtitle: "Pick a song in the Library";
    in property <bool> loaded;
    in-out property <int> mode: 1;   // 0 listen, 1 learn, 2 follow
    in-out property <int> hands: 0;  // 0 both, 1 right, 2 left
    in property <int> tempo: 100;
    in property <int> state;         // 0 stopped, 1 playing, 2 waiting, 3 paused, 4 finished
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress;
    in property <string> prompt: "";
    in property <string> accuracy: "—";
    in property <string> steps: "—";
    in property <string> streak: "0";
    in property <string> wrong: "0";
    in property <[KeyView]> keys;
    in property <[RollNote]> roll;
    in property <length> now-line;   // y of the "now" line inside the roll
    // Practice loop: positions as fractions of the song, -1 = unset.
    in property <float> loop-a: -1;
    in property <float> loop-b: -1;
    in property <bool> looping;
    in property <string> loop-text: "";
    callback set-loop-a();
    callback set-loop-b();
    callback clear-loop();
    callback play-pause();
    callback stop();
    callback restart();
    callback set-mode(int);
    callback set-hands(int);
    callback tempo-step(int);
    callback seek(float);
}

export global SettingsVM {
    in-out property <float> brightness: 80;
    in-out property <bool> accompany: true;
    in-out property <bool> easy: false;
    in-out property <bool> led-off-on-hit: true;
    in-out property <float> lead: 700;
    in property <string> library-root: "";
    in property <string> panel: "";
    // Where notes sound: 0 piano, 1 the board's speaker, 2 both.
    in-out property <int> sound: 0;
    in-out property <float> speaker-volume: 70;
    callback set-sound(int);
    callback set-speaker-volume(float);
    in-out property <int> transport: 0; // 0 USB, 1 Bluetooth
    callback set-transport(int);
    callback set-brightness(float);
    callback set-accompany(bool);
    callback set-easy(bool);
    callback set-led-off-on-hit(bool);
    callback set-lead(float);
    callback led-test();
    callback all-off();
    callback rescan();
}
