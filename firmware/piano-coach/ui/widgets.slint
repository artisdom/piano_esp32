import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

// Pill/rounded button with optional icon. `primary` = filled accent.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <length> font-size: Theme.fs;
    callback clicked;
    min-height: 56px;
    min-width: 56px;
    border-radius: self.height / 2;
    background: !enabled ? Theme.surface2 : primary ? (ta.pressed ? Theme.accent.darker(0.25) : Theme.accent)
        : (ta.pressed ? Theme.raised.brighter(0.2) : Theme.raised);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.text == "" ? 0 : 22px;
        padding-right: root.text == "" ? 0 : 22px;
        spacing: 10px;
        alignment: center;
        if root.icon != "": Icon {
            name: root.icon;
            y: (parent.height - self.height) / 2;
            size: root.text == "" ? 30px : 24px;
            tint: !root.enabled ? Theme.faint : root.primary ? #ffffff : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.font-size;
            font-weight: 600;
            color: !root.enabled ? Theme.faint : root.primary ? #ffffff : Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Segmented control: one of `options` selected.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <[string]> icons;
    in-out property <int> selected;
    callback changed(int);
    height: 52px;
    border-radius: self.height / 2;
    background: Theme.surface2;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for opt[i] in root.options: Rectangle {
            border-radius: self.height / 2;
            background: i == root.selected ? Theme.raised.brighter(0.15) : transparent;
            animate background { duration: 150ms; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;
                if root.icons.length > i && root.icons[i] != "": Icon {
                    y: (parent.height - self.height) / 2;
                    name: root.icons[i];
                    size: 22px;
                    tint: i == root.selected ? Theme.text : Theme.dim;
                }
                Text {
                    text: opt;
                    vertical-alignment: center;
                    font-size: Theme.fs-sm;
                    font-weight: i == root.selected ? 700 : 500;
                    color: i == root.selected ? Theme.text : Theme.dim;
                }
            }
            TouchArea {
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);
    min-height: 64px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.text; font-size: Theme.fs; color: Theme.text; }
            if root.hint != "": Text {
                text: root.hint;
                font-size: Theme.fs-xs;
                color: Theme.dim;
                wrap: word-wrap;
            }
        }
        Rectangle {
            width: 64px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: root.checked ? Theme.accent : Theme.raised;
            animate background { duration: 150ms; }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                y: 4px;
                x: root.checked ? parent.width - self.width - 4px : 4px;
                animate x { duration: 150ms; easing: ease-out; }
                background: #ffffff;
            }
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Horizontal slider, value in [minimum, maximum].
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <color> fill: Theme.accent;
    callback changed(float);
    callback released(float);
    height: 44px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: 4px;
        background: Theme.raised;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: 4px;
        width: (root.value - root.minimum) / (root.maximum - root.minimum) * parent.width;
        background: root.fill;
    }
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: #ffffff;
        y: (parent.height - self.height) / 2;
        x: (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - self.width);
    }
    ta := TouchArea {
        function set(px: length) {
            root.value = max(root.minimum, min(root.maximum,
                root.minimum + (px / root.width) * (root.maximum - root.minimum)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.set(self.mouse-x); }
            if e.kind == PointerEventKind.up { root.released(root.value); }
        }
        moved => { self.set(self.mouse-x); }
    }
}

// Small status pill: dot + label.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.dim;
    in property <string> icon;
    height: 40px;
    border-radius: 20px;
    background: Theme.surface2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 20px;
            tint: root.tone;
        }
        if root.icon == "": Rectangle {
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.tone;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.fs-sm;
            color: Theme.text;
            overflow: elide;
        }
    }
}

// Touch drags reach Slint amplified by this factor from the press point
// (src/ui.rs SCROLL_GAIN), which makes flick-scrolling lists fast. Controls
// that track the finger 1:1 (the scrollbar thumb) divide it back out.
export global Touch {
    out property <float> drag-gain: 2.0;
}

// Scrollable column with a wide, finger-sized scrollbar on the right. Drag
// the thumb, or tap anywhere on the track to jump there; the list itself
// still flick-scrolls. Children are laid out top to bottom.
export component WideScroll inherits Rectangle {
    in property <length> bar-width: 34px;
    in property <length> spacing: 2px;
    property <length> track-h: self.height;
    property <length> range: max(0px, fl.content-height - fl.height);
    property <length> thumb-h: fl.content-height <= fl.height ? self.height
        : max(64px, self.height * fl.height / fl.content-height);
    property <length> press-y;

    function scroll-to(thumb-top: length) {
        fl.content-y = -max(0px, min(root.range,
            (thumb-top / max(1px, root.track-h - root.thumb-h)) * root.range));
    }

    fl := Flickable {
        x: 0;
        width: root.range > 0 ? parent.width - root.bar-width - 10px : parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: fl.width;
            spacing: root.spacing;
            @children
        }
    }
    if root.range > 0: Rectangle {
        x: parent.width - root.bar-width;
        width: root.bar-width;
        height: parent.height;
        border-radius: self.width / 2;
        background: Theme.surface2;
        Rectangle {
            x: 4px;
            width: parent.width - 8px;
            height: root.thumb-h - 8px;
            y: 4px + (-fl.content-y / root.range) * (root.track-h - root.thumb-h);
            border-radius: self.width / 2;
            background: ta.pressed ? Theme.accent : Theme.faint;
            animate background { duration: 120ms; }
        }
        ta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.press-y = self.mouse-y;
                    root.scroll-to(self.mouse-y - root.thumb-h / 2);
                }
            }
            moved => {
                // Undo the touch drag gain so the thumb stays under the finger.
                root.scroll-to(root.press-y + (self.mouse-y - root.press-y) / Touch.drag-gain - root.thumb-h / 2);
            }
        }
    }
}
