import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Card, Toggle, Slider, Segmented } from "widgets.slint";
import { SettingsVM, AppVM, PlayerVM } from "state.slint";

component Heading inherits Text {
    font-size: Theme.fs-lg;
    font-weight: 700;
    color: Theme.text;
}

component Info inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text { text: root.label; color: Theme.dim; font-size: Theme.fs-sm; min-width: 130px; }
    Text { text: root.value; color: Theme.text; font-size: Theme.fs-sm; overflow: elide; horizontal-stretch: 1; }
}

export component SettingsPage inherits Rectangle {
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 6px;
                Heading { text: "Learning"; }
                Toggle {
                    text: "Piano plays the other hand";
                    hint: "In Learn and Follow, the hand you are not practising is played for you.";
                    checked <=> SettingsVM.accompany;
                    toggled(v) => { SettingsVM.set-accompany(v); }
                }
                Toggle {
                    text: "Easy mode";
                    hint: "Learn: any key moves on to the next chord — for little fingers.";
                    checked <=> SettingsVM.easy;
                    toggled(v) => { SettingsVM.set-easy(v); }
                }
                Toggle {
                    text: "Hint LED off when pressed";
                    hint: "Learn: a key's red light goes out as soon as you play it.";
                    checked <=> SettingsVM.led-off-on-hit;
                    toggled(v) => { SettingsVM.set-led-off-on-hit(v); }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    Text { text: "Follow: light keys ahead"; color: Theme.text; font-size: Theme.fs; horizontal-stretch: 1; }
                    Text { text: round(SettingsVM.lead) + " ms"; color: Theme.dim; font-size: Theme.fs; }
                }
                Slider {
                    minimum: 200;
                    maximum: 1500;
                    value <=> SettingsVM.lead;
                    released(v) => { SettingsVM.set-lead(v); }
                }
                Rectangle { height: 8px; }
                // Sheet music (Play page → Sheet).
                Text { text: "Sheet music note colours"; color: Theme.text; font-size: Theme.fs; }
                Segmented {
                    options: ["Ink", "Boomwhackers", "Rainbow"];
                    selected: PlayerVM.sheet-colors;
                    changed(i) => { PlayerVM.set-sheet-colors(i); }
                }
                Text { text: "Note names in the heads"; color: Theme.text; font-size: Theme.fs; }
                Segmented {
                    options: ["Off", "C D E", "Do Re Mi"];
                    selected: PlayerVM.sheet-names;
                    changed(i) => { PlayerVM.set-sheet-names(i); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        // Three columns so every card fits the 648 px page without scrolling.
        Card {
            width: 400px;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Heading { text: "Piano"; }
                Text { text: "Connect via"; color: Theme.text; font-size: Theme.fs; }
                Segmented {
                    options: ["USB cable", "Bluetooth"];
                    icons: ["usb", "bluetooth"];
                    selected: SettingsVM.transport;
                    changed(i) => { SettingsVM.set-transport(i); }
                }
                Text {
                    text: "Switching restarts the device.";
                    color: Theme.dim;
                    font-size: Theme.fs-xs;
                }
                Info { label: "Status"; value: AppVM.device; }
                Info { label: "Panel"; value: SettingsVM.panel; }
                Text { text: "Notes sound from"; color: Theme.text; font-size: Theme.fs; }
                Segmented {
                    options: ["Piano", "Speaker", "Both"];
                    icons: ["note", "volume", ""];
                    selected: SettingsVM.sound;
                    changed(i) => { SettingsVM.set-sound(i); }
                }
                HorizontalLayout {
                    Text { text: "Speaker volume"; color: SettingsVM.sound == 0 ? Theme.faint : Theme.text; font-size: Theme.fs-sm; horizontal-stretch: 1; }
                    Text { text: round(SettingsVM.speaker-volume) + "%"; color: Theme.dim; font-size: Theme.fs-sm; }
                }
                Slider {
                    height: 36px;
                    minimum: 0;
                    maximum: 100;
                    value <=> SettingsVM.speaker-volume;
                    changed(v) => { SettingsVM.set-speaker-volume(v); }
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Light all keys";
                    icon: "bulb";
                    enabled: AppVM.connected;
                    clicked => { SettingsVM.led-test(); }
                }
                Button {
                    text: "All LEDs off";
                    icon: "stop";
                    enabled: AppVM.connected;
                    clicked => { SettingsVM.all-off(); }
                }
            }
        }
        Card {
            width: 400px;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Heading { text: "Display & library"; }
                if AppVM.has-backlight: HorizontalLayout {
                    Text { text: "Brightness"; color: Theme.text; font-size: Theme.fs; horizontal-stretch: 1; }
                    Text { text: round(SettingsVM.brightness) + "%"; color: Theme.dim; font-size: Theme.fs; }
                }
                if AppVM.has-backlight: Slider {
                    minimum: 10;
                    maximum: 100;
                    value <=> SettingsVM.brightness;
                    changed(v) => { SettingsVM.set-brightness(v); }
                }
                Info { label: "Board"; value: AppVM.board-name; }
                Toggle {
                    text: "Show touches";
                    checked <=> AppVM.show-touches;
                    toggled(v) => { AppVM.set-show-touches(v); }
                }
                Info { label: "microSD"; value: AppVM.sd-status; }
                Info { label: "Songs folder"; value: SettingsVM.library-root; }
                Info { label: "Firmware"; value: AppVM.version; }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Rescan SD card";
                    icon: "sd";
                    clicked => { SettingsVM.rescan(); }
                }
                Button {
                    text: "Shut down";
                    icon: "power";
                    clicked => { AppVM.confirm-shutdown = true; }
                }
            }
        }
    }
}
