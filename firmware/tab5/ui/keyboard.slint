import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

component Key inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback pressed;
    border-radius: 12px;
    background: ta.pressed ? Theme.accent : Theme.raised;
    if root.icon == "": Text {
        text: root.text;
        font-size: 28px;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "": Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 28px;
    }
    ta := TouchArea { clicked => { root.pressed(); } }
}

// Latin on-screen keyboard for search. Chinese titles are found by pinyin
// or pinyin initials, so letters and digits are all that is needed.
//
// Keys fill the whole width given to the keyboard: one key unit is a tenth
// of the row (minus gaps); rows are staggered like a real keyboard and the
// last row ends with 1.5-unit Erase / Clear keys.
export component SearchKeyboard inherits Rectangle {
    callback key(string);
    callback backspace();
    callback clear();
    in property <length> gap: 8px;
    in property <length> key-height: 64px;
    property <length> unit: (self.width - 9 * self.gap) / 10;
    height: 4 * self.key-height + 3 * self.gap;

    for row[r] in [["1","2","3","4","5","6","7","8","9","0"],
                   ["q","w","e","r","t","y","u","i","o","p"],
                   ["a","s","d","f","g","h","j","k","l"],
                   ["z","x","c","v","b","n","m"]]: Rectangle {
        y: r * (root.key-height + root.gap);
        height: root.key-height;
        // Row 3 (9 keys) is centred; others start at the left edge.
        property <length> offset: row.length == 9 ? (root.unit + root.gap) / 2 : 0;
        for k[i] in row: Key {
            x: parent.offset + i * (root.unit + root.gap);
            width: root.unit;
            height: root.key-height;
            text: k;
            pressed => { root.key(k); }
        }
        // Erase / clear finish the last row: 7 letters + 1.5 + 1.5 units.
        if row.length == 7: Key {
            x: 7 * (root.unit + root.gap);
            width: 1.5 * root.unit + root.gap / 2;
            height: root.key-height;
            icon: "erase";
            pressed => { root.backspace(); }
        }
        if row.length == 7: Key {
            x: 8.5 * (root.unit + root.gap);
            width: root.width - self.x;
            height: root.key-height;
            icon: "close";
            pressed => { root.clear(); }
        }
    }
}
