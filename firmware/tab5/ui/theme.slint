// Visual tokens. Dark stage-like theme; red is reserved for the piano's own
// LEDs (hints) so the screen and the keys speak the same language.
export global Theme {
    out property <color> bg: #0e1116;
    out property <color> surface: #161b22;
    out property <color> surface2: #1d242d;
    out property <color> raised: #252d38;
    out property <color> border: #2b3440;
    out property <color> text: #e9eef4;
    out property <color> dim: #8d99a6;
    out property <color> faint: #5b6673;

    out property <color> led: #ff3b4f;        // hint / LED red
    out property <color> led-glow: #ff3b4f55;
    out property <color> accent: #ff5a6a;
    out property <color> right-hand: #34d3c2; // teal
    out property <color> left-hand: #9b87ff;  // violet
    out property <color> pressed: #4da3ff;    // your fingers
    out property <color> ok: #4ade80;
    out property <color> warn: #fbbf24;

    out property <length> radius: 14px;
    out property <length> radius-sm: 9px;
    out property <length> fs-xs: 14px;
    out property <length> fs-sm: 16px;
    out property <length> fs: 19px;
    out property <length> fs-lg: 24px;
    out property <length> fs-xl: 32px;
}
