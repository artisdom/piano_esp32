import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Card, WideScroll } from "widgets.slint";
import { LibraryVM, LibEntry, LegendItem, SettingsVM } from "state.slint";
import { SearchKeyboard } from "keyboard.slint";

// Size of the song-globe image rendered by src/ui.rs (must match there).
export global SphereGeom {
    out property <length> w: 760px;
    out property <length> h: 456px;
}

component Row inherits Rectangle {
    in property <LibEntry> entry;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked;
    height: compact ? 60px : 76px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.raised : ta.pressed ? Theme.surface2 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.entry.is-dir ? #2a3442 : #2b2230;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.entry.is-dir ? "folder" : "note";
                size: 26px;
                tint: root.entry.is-dir ? Theme.warn : Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                font-size: Theme.fs;
                color: Theme.text;
                overflow: elide;
            }
            if root.entry.subtitle != "": Text {
                text: root.entry.subtitle;
                font-size: Theme.fs-xs;
                color: Theme.dim;
                overflow: elide;
            }
        }
        // Best-score stars and bookmark marker.
        if root.entry.badge != "": Text {
            text: root.entry.badge;
            font-size: Theme.fs-sm;
            color: Theme.warn;
            vertical-alignment: center;
        }
        if root.entry.fav: Icon {
            y: (parent.height - self.height) / 2;
            name: "star";
            size: 22px;
            tint: #ffc82e;
        }
        if root.entry.is-dir: Icon {
            y: (parent.height - self.height) / 2;
            name: "chevron";
            tint: Theme.faint;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Icon-only tab used for the four library views.
component ViewTab inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    width: 58px;
    height: 52px;
    border-radius: 26px;
    background: active ? Theme.raised.brighter(0.15) : ta.pressed ? Theme.surface2 : transparent;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 24px;
        tint: root.active ? Theme.text : Theme.dim;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Globe inherits Rectangle {
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            vertical-stretch: 1;
            // Empty panel: src/globe.rs paints the spinning globe straight
            // into the framebuffer here (faster than handing Slint a new image
            // every frame). It needs the panel's position on screen.
            area := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: SphereGeom.w;
                height: SphereGeom.h;
                // Report where we are. `init` can run before layout, so also
                // report whenever the position changes once laid out.
                init => { LibraryVM.sphere-origin(self.absolute-position.x, self.absolute-position.y); }
                changed absolute-position => { LibraryVM.sphere-origin(self.absolute-position.x, self.absolute-position.y); }
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            LibraryVM.sphere-origin(area.absolute-position.x, area.absolute-position.y);
                            LibraryVM.sphere-pointer(0, self.mouse-x, self.mouse-y);
                        }
                        if e.kind == PointerEventKind.up { LibraryVM.sphere-pointer(2, self.mouse-x, self.mouse-y); }
                    }
                    moved => { LibraryVM.sphere-pointer(1, self.mouse-x, self.mouse-y); }
                }
            }
        }
        // Category legend; tap to turn that band towards you.
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            alignment: center;
            for item[i] in LibraryVM.legend: Rectangle {
                width: lg.preferred-width + 36px;
                border-radius: 17px;
                background: lta.pressed ? Theme.raised : Theme.surface2;
                Rectangle {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: item.tint;
                }
                lg := Text {
                    x: 28px;
                    text: item.name;
                    font-size: Theme.fs-xs;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                lta := TouchArea { clicked => { LibraryVM.legend-tap(i); } }
            }
        }
    }
}

export component LibraryPage inherits Rectangle {
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Card {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                // Browse header: back, title + path, view tabs, search.
                if !LibraryVM.searching: HorizontalLayout {
                    height: 60px;
                    spacing: 8px;
                    padding-left: 4px;
                    if LibraryVM.view == 0 && LibraryVM.crumbs.length > 1: Button {
                        icon: "back";
                        width: 56px;
                        clicked => { LibraryVM.up(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: LibraryVM.view == 1 ? "Bookmarks"
                                : LibraryVM.view == 2 ? "Recently played"
                                : LibraryVM.view == 3 ? "Song globe"
                                : LibraryVM.crumbs.length > 0 ? LibraryVM.crumbs[LibraryVM.crumbs.length - 1] : "Library";
                            font-size: Theme.fs-lg;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: LibraryVM.path-text;
                            font-size: Theme.fs-xs;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        width: tabs.preferred-width + 8px;
                        height: 60px;
                        border-radius: 30px;
                        background: Theme.surface2;
                        tabs := HorizontalLayout {
                            x: 4px;
                            alignment: center;
                            spacing: 2px;
                            ViewTab { icon: "folder"; active: LibraryVM.view == 0; y: 4px; clicked => { LibraryVM.set-view(0); } }
                            ViewTab { icon: "star"; active: LibraryVM.view == 1; y: 4px; clicked => { LibraryVM.set-view(1); } }
                            ViewTab { icon: "history"; active: LibraryVM.view == 2; y: 4px; clicked => { LibraryVM.set-view(2); } }
                            ViewTab { icon: "globe"; active: LibraryVM.view == 3; y: 4px; clicked => { LibraryVM.set-view(3); } }
                        }
                    }
                    Button {
                        icon: "search";
                        width: 60px;
                        clicked => { LibraryVM.search-toggle(); }
                    }
                }
                // Search header: the query box itself.
                if LibraryVM.searching: HorizontalLayout {
                    height: 60px;
                    spacing: 12px;
                    Rectangle {
                        border-radius: 30px;
                        background: Theme.surface2;
                        border-width: 2px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;
                            Icon { y: (parent.height - self.height) / 2; name: "search"; size: 22px; tint: Theme.dim; }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: LibraryVM.query == "" ? "Type pinyin, initials or letters — e.g. xyz for 小燕子" : LibraryVM.query;
                                    font-size: LibraryVM.query == "" ? Theme.fs-sm : Theme.fs-lg;
                                    color: LibraryVM.query == "" ? Theme.faint : Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: LibraryVM.search-status;
                                    font-size: Theme.fs-xs;
                                    color: Theme.dim;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    Button {
                        icon: "close";
                        width: 60px;
                        clicked => { LibraryVM.search-toggle(); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if !LibraryVM.searching && LibraryVM.view != 3 && LibraryVM.entries.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding: 40px;
                    Text {
                        text: LibraryVM.empty-text;
                        color: Theme.dim;
                        font-size: Theme.fs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if LibraryVM.view == 0: HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Rescan SD card";
                            icon: "sd";
                            clicked => { SettingsVM.rescan(); }
                        }
                    }
                }
                if !LibraryVM.searching && LibraryVM.view != 3 && LibraryVM.entries.length > 0: WideScroll {
                    vertical-stretch: 1;
                    for e[i] in LibraryVM.entries: Row {
                        entry: e;
                        selected: i == LibraryVM.selected;
                        clicked => { LibraryVM.open(i); }
                    }
                }
                if !LibraryVM.searching && LibraryVM.view == 3: Globe {
                    vertical-stretch: 1;
                }
                if LibraryVM.searching: WideScroll {
                    vertical-stretch: 1;
                    for e[i] in LibraryVM.results: Row {
                        entry: e;
                        compact: true;
                        selected: i == LibraryVM.result-selected;
                        clicked => { LibraryVM.open-result(i); }
                    }
                }
                if LibraryVM.searching: SearchKeyboard {
                    key-height: 66px;
                    key(k) => { LibraryVM.type-key(k); }
                    backspace => { LibraryVM.backspace(); }
                    clear => { LibraryVM.clear-query(); }
                }
            }
        }
        Card {
            // Narrower while searching so the keyboard gets more width.
            width: LibraryVM.searching ? 340px : 400px;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                // Album-art style tile (hidden while searching).
                if !LibraryVM.searching: Rectangle {
                    height: 150px;
                    border-radius: Theme.radius;
                    background: @linear-gradient(135deg, #3a1d2c 0%, #1d2a3a 100%);
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: LibraryVM.sel-title == "" ? "library" : "note";
                        size: 76px;
                        tint: LibraryVM.sel-title == "" ? Theme.faint : Theme.accent;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: LibraryVM.sel-title == "" ? "Choose a song" : LibraryVM.sel-title;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    // Bookmark toggle.
                    if LibraryVM.sel-ready: Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: fta.pressed ? Theme.raised : Theme.surface2;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: LibraryVM.sel-fav ? "star" : "star-o";
                            size: 26px;
                            tint: LibraryVM.sel-fav ? #ffc82e : Theme.dim;
                        }
                        fta := TouchArea { clicked => { LibraryVM.toggle-fav(); } }
                    }
                }
                Text {
                    text: LibraryVM.sel-subtitle;
                    font-size: Theme.fs;
                    color: Theme.dim;
                    overflow: elide;
                }
                Text {
                    text: LibraryVM.sel-error != "" ? LibraryVM.sel-error : LibraryVM.sel-info;
                    font-size: Theme.fs-sm;
                    color: LibraryVM.sel-error != "" ? Theme.warn : Theme.dim;
                    wrap: word-wrap;
                }
                if LibraryVM.sel-scores != "": Text {
                    text: LibraryVM.sel-scores;
                    font-size: Theme.fs-sm;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Learn";
                    icon: "learn";
                    primary: true;
                    enabled: LibraryVM.sel-ready;
                    clicked => { LibraryVM.start(1); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        text: "Follow";
                        icon: "follow";
                        enabled: LibraryVM.sel-ready;
                        clicked => { LibraryVM.start(2); }
                    }
                    Button {
                        text: "Listen";
                        icon: "listen";
                        enabled: LibraryVM.sel-ready;
                        clicked => { LibraryVM.start(0); }
                    }
                }
            }
        }
    }
}
