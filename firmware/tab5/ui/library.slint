import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Card } from "widgets.slint";
import { LibraryVM, LibEntry, SettingsVM } from "state.slint";
import { SearchKeyboard } from "keyboard.slint";

component Row inherits Rectangle {
    in property <LibEntry> entry;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked;
    height: compact ? 60px : 76px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.raised : ta.pressed ? Theme.surface2 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        Rectangle {
            width: 48px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.entry.is-dir ? #2a3442 : #2b2230;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.entry.is-dir ? "folder" : "note";
                size: 26px;
                tint: root.entry.is-dir ? Theme.warn : Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                font-size: Theme.fs;
                color: Theme.text;
                overflow: elide;
            }
            if root.entry.subtitle != "": Text {
                text: root.entry.subtitle;
                font-size: Theme.fs-xs;
                color: Theme.dim;
                overflow: elide;
            }
        }
        if root.entry.is-dir: Icon {
            y: (parent.height - self.height) / 2;
            name: "chevron";
            tint: Theme.faint;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component LibraryPage inherits Rectangle {
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Card {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                // Browse header: back, folder title + path, search button.
                if !LibraryVM.searching: HorizontalLayout {
                    height: 60px;
                    spacing: 12px;
                    padding-left: 4px;
                    if LibraryVM.crumbs.length > 1: Button {
                        icon: "back";
                        width: 56px;
                        clicked => { LibraryVM.up(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: LibraryVM.crumbs.length > 0 ? LibraryVM.crumbs[LibraryVM.crumbs.length - 1] : "Library";
                            font-size: Theme.fs-lg;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: LibraryVM.path-text;
                            font-size: Theme.fs-xs;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }
                    Button {
                        icon: "search";
                        text: "Search";
                        clicked => { LibraryVM.search-toggle(); }
                    }
                }
                // Search header: the query box itself.
                if LibraryVM.searching: HorizontalLayout {
                    height: 60px;
                    spacing: 12px;
                    Rectangle {
                        border-radius: 30px;
                        background: Theme.surface2;
                        border-width: 2px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;
                            Icon { y: (parent.height - self.height) / 2; name: "search"; size: 22px; tint: Theme.dim; }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: LibraryVM.query == "" ? "Type pinyin, initials or letters — e.g. xyz for 小燕子" : LibraryVM.query;
                                    font-size: LibraryVM.query == "" ? Theme.fs-sm : Theme.fs-lg;
                                    color: LibraryVM.query == "" ? Theme.faint : Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: LibraryVM.search-status;
                                    font-size: Theme.fs-xs;
                                    color: Theme.dim;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    Button {
                        icon: "close";
                        width: 60px;
                        clicked => { LibraryVM.search-toggle(); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if !LibraryVM.searching && LibraryVM.entries.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding: 40px;
                    Text {
                        text: LibraryVM.empty-text;
                        color: Theme.dim;
                        font-size: Theme.fs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Rescan SD card";
                            icon: "sd";
                            clicked => { SettingsVM.rescan(); }
                        }
                    }
                }
                if !LibraryVM.searching && LibraryVM.entries.length > 0: ListView {
                    for e[i] in LibraryVM.entries: Row {
                        entry: e;
                        selected: i == LibraryVM.selected;
                        clicked => { LibraryVM.open(i); }
                    }
                }
                if LibraryVM.searching: ListView {
                    vertical-stretch: 1;
                    for e[i] in LibraryVM.results: Row {
                        entry: e;
                        compact: true;
                        selected: i == LibraryVM.result-selected;
                        clicked => { LibraryVM.open-result(i); }
                    }
                }
                if LibraryVM.searching: SearchKeyboard {
                    key-height: 66px;
                    key(k) => { LibraryVM.type-key(k); }
                    backspace => { LibraryVM.backspace(); }
                    clear => { LibraryVM.clear-query(); }
                }
            }
        }
        Card {
            // Narrower while searching so the keyboard gets more width.
            width: LibraryVM.searching ? 340px : 420px;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                // Album-art style tile (hidden while searching).
                if !LibraryVM.searching: Rectangle {
                    height: 170px;
                    border-radius: Theme.radius;
                    background: @linear-gradient(135deg, #3a1d2c 0%, #1d2a3a 100%);
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: LibraryVM.sel-title == "" ? "library" : "note";
                        size: 84px;
                        tint: LibraryVM.sel-title == "" ? Theme.faint : Theme.accent;
                    }
                }
                Text {
                    text: LibraryVM.sel-title == "" ? "Choose a song" : LibraryVM.sel-title;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: LibraryVM.sel-subtitle;
                    font-size: Theme.fs;
                    color: Theme.dim;
                    overflow: elide;
                }
                Text {
                    text: LibraryVM.sel-error != "" ? LibraryVM.sel-error : LibraryVM.sel-info;
                    font-size: Theme.fs-sm;
                    color: LibraryVM.sel-error != "" ? Theme.warn : Theme.dim;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Learn";
                    icon: "learn";
                    primary: true;
                    enabled: LibraryVM.sel-ready;
                    clicked => { LibraryVM.start(1); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        text: "Follow";
                        icon: "follow";
                        enabled: LibraryVM.sel-ready;
                        clicked => { LibraryVM.start(2); }
                    }
                    Button {
                        text: "Listen";
                        icon: "listen";
                        enabled: LibraryVM.sel-ready;
                        clicked => { LibraryVM.start(0); }
                    }
                }
            }
        }
    }
}
