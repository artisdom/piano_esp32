# piano-tab5 — ESP-IDF configuration for the M5Stack Tab5 (ESP32-P4 rev 1.3).
# Board facts below were established by the herdline Tab5 client
# (~/w/rust/herdline/clients/tab5/boards/tab5/sdkconfig.defaults).

# Tab5 silicon is rev v1.3; IDF 5.5 otherwise links a rev-3 bootloader that
# faults on its first instruction.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz scheduler tick: MIDI timing needs ms resolution (100 Hz would
# quantise every sleep to 10 ms).
CONFIG_FREERTOS_HZ=1000

# Keep the IDF main task bootstrap-only (its stack comes from the small
# pre-scheduler heap); main.rs spawns the real application task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# 32 MB PSRAM at 200 MHz for framebuffers, the render shadow buffer, songs.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Two DPI framebuffers: render into the back buffer, then swap.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2

# microSD: long file names in UTF-8 (the song library is Chinese).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_USE_LABEL=y
CONFIG_VFS_MAX_COUNT=8

# ---- Bluetooth LE via the C6 (BLE-MIDI mode) --------------------------------
# Settings from the herdline Tab5 client. Only one transport runs per boot:
# in USB mode the C6 stays unpowered and none of this starts.
#
# ESP-Hosted SDIO link: the Tab5 wires the C6 to SDIO slot 1 as below.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=25000
# Transport mempool in PSRAM (internal RAM would be exhausted at init).
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# NimBLE host on the P4, controller on the C6 over hosted HCI.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=260
CONFIG_BT_NIMBLE_NVS_PERSIST=y
