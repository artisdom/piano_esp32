# piano-tab5 — ESP-IDF configuration for the M5Stack Tab5 (ESP32-P4 rev 1.3).
# Board facts below were established by the herdline Tab5 client
# (~/w/rust/herdline/clients/tab5/boards/tab5/sdkconfig.defaults).

# Tab5 silicon is rev v1.3; IDF 5.5 otherwise links a rev-3 bootloader that
# faults on its first instruction.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz scheduler tick: MIDI timing needs ms resolution (100 Hz would
# quantise every sleep to 10 ms).
CONFIG_FREERTOS_HZ=1000

# Keep the IDF main task bootstrap-only (its stack comes from the small
# pre-scheduler heap); main.rs spawns the real application task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# 32 MB PSRAM at 200 MHz for framebuffers, the render shadow buffer, songs.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Two DPI framebuffers: render into the back buffer, then swap.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2

# microSD: long file names in UTF-8 (the song library is Chinese).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_USE_LABEL=y
CONFIG_VFS_MAX_COUNT=8

# No radio is used: Bluetooth stays off and the C6 coprocessor unpowered,
# which also avoids the USB-HS-host vs SDIO conflict herdline hit.
CONFIG_BT_ENABLED=n
